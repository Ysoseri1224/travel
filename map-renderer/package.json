{
  "name": "@ysoseri/travel-map-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:data": "node scripts/fetch-geoboundaries.mjs",
    "render:preview": "node scripts/render-preview.mjs",
    "render:props": "node scripts/render-paper-props.mjs && node scripts/verify-paper-props.mjs",
